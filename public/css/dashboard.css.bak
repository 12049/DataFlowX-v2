:root{
  --bg:#0f1115;
  --card:rgba(27,31,39,0.6);
  --border:rgba(44,47,56,0.5);
  --text:#e6e6e6;
  --muted:#9da3ae;
  --accent:#7a6c55;
  --danger:#ff4c4c;
}

*{margin:0;padding:0;box-sizing:border-box;font-family:Poppins,sans-serif;}
body, html{width:100%;height:100%;background:linear-gradient(135deg,#0d0f12,#1b1f27);color:var(--text);backdrop-filter:blur(2px);overflow-x:hidden;}

header{display:flex;justify-content:space-between;align-items:center;padding:15px 25px;border-bottom:1px solid var(--border);backdrop-filter:blur(5px);}
header .logo{font-weight:600;font-size:18px}
header .nav-icons{display:flex;gap:18px}
header .nav-icons i{cursor:pointer;font-size:18px;transition:.3s;color:var(--text)}
header .nav-icons i:hover{color:var(--accent)}

.sidebar{
  position:fixed;
  top:0;
  left:-280px;
  width:280px;
  height:100%;
  background:var(--card);
  backdrop-filter:blur(8px);
  border-right:1px solid var(--border);
  padding:20px;
  display:flex;
  flex-direction:column;
  gap:20px;
  transition:0.5s;
  z-index:9999;
  overflow-y:auto;
}
.sidebar.active{left:0;}
.sidebar .close-btn{position:absolute;top:15px;right:15px;font-size:18px;cursor:pointer;color:var(--text);}
.sidebar .close-btn:hover{color:var(--danger);}
.sidebar .user-info{display:flex;align-items:center;gap:10px;margin-bottom:20px;}
.sidebar .user-info img{width:50px;height:50px;border-radius:50%;border:2px solid var(--border);object-fit:cover;}
.sidebar .user-info div{display:flex;flex-direction:column;font-size:13px}
.sidebar .menu-item{display:flex;align-items:center;justify-content:space-between;cursor:pointer;padding:10px;border-radius:12px;position:relative;transition:.3s; border-bottom:1px solid var(--border);}
.sidebar .menu-item:hover{background:rgba(255,255,255,0.05)}
.sidebar .menu-item .dot{width:10px;height:10px;border-radius:50%;background:var(--border);margin-left:8px;transition:.3s;}
.sidebar .submenu{max-height:0;overflow:hidden;transition:max-height .3s;display:flex;flex-direction:column;margin-left:20px;gap:10px}
.sidebar .submenu a{color:var(--muted);font-size:13px;text-decoration:none;display:flex;align-items:center;gap:6px;position:relative;padding-left:20px;border-bottom:1px solid var(--border);}
.sidebar .submenu a .dot{position:absolute;left:0;width:10px;height:10px;border-radius:50%;background:var(--border);top:50%;transform:translateY(-50%);transition:.3s;}
.sidebar .submenu a.active .dot{background:var(--accent);}
.sidebar .menu-item.active .dot{background:var(--accent);}
.sidebar .menu-item .arrow{transition:transform 0.3s;}
.logout{margin-top:auto;padding:10px;border-radius:12px;background:var(--danger);text-align:center;color:#fff;cursor:pointer}

.container{margin-left:0;transition:.5s;padding:25px;}
.container.shift{margin-left:280px;}

.welcome-card{background:var(--card);padding:30px;border-radius:20px;margin-bottom:30px;box-shadow:0 15px 30px rgba(0,0,0,0.5);display:flex;align-items:center;gap:15px;}
.welcome-card h1{font-size:28px;margin-bottom:10px}
.welcome-card p{color:var(--muted)}

.section{margin-bottom:40px}
.section h2{margin-bottom:15px;font-size:20px;border-left:4px solid var(--accent);padding-left:10px}
.section .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:15px}
.section .card{background:var(--card);padding:20px;border-radius:15px;backdrop-filter:blur(5px);transition:.3s; display:flex;align-items:center;gap:8px;}
.section .card:hover{transform:translateY(-4px)}
.section .card i{margin-right:8px;color:var(--accent);}

footer{background:#0b0d11;padding:50px 20px;color:var(--muted);border-top:1px solid var(--border);}
footer .footer-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:20px;margin-bottom:20px}
footer .footer-grid h4{color:var(--text);margin-bottom:10px}
footer .social{display:flex;gap:10px}
footer .social a{width:38px;height:38px;display:flex;align-items:center;justify-content:center;border-radius:50%;border:1px solid var(--border);color:var(--text);transition:.3s;text-decoration:none}
footer .social a:hover{background:var(--accent);color:#000}
#loaderOverlay {
  position: fixed;
  top:0; left:0;
  width:100%; height:100%;
  background: rgba(0,0,0,0.7);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 9999; /* اعلى من كل شيء */
  display: none; /* مخفي افتراضياً */
}

#loaderCard {
  background: var(--card);
  padding: 20px 30px;
  border-radius: 18px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 15px;
  backdrop-filter: blur(15px);
  box-shadow: 0 8px 30px rgba(0,0,0,0.7);
  transform: scale(0);
}

.loaderCircle {
  width: 40px;
  height: 40px;
  border: 4px solid rgba(255,255,255,0.2);
  border-top: 4px solid var(--accent);
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

.loaderText {
  color: #fff;
  font-weight: 600;
  font-family: Poppins, sans-serif;
  font-size: 14px;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}
/* =======================
   Example Code Section
======================= */

.code-tabs{
  display:flex;
  gap:12px;
  margin-bottom:15px;
  flex-wrap:wrap;
}

.code-tabs .tab{
  padding:8px 16px;
  border-radius:14px;
  background:rgba(255,255,255,0.03);
  border:1px solid var(--border);
  color:var(--muted);
  cursor:pointer;
  font-size:13px;
  transition:.35s;
  position:relative;
  overflow:hidden;
}

.code-tabs .tab::after{
  content:"";
  position:absolute;
  inset:0;
  background:linear-gradient(
    120deg,
    transparent,
    rgba(255,255,255,0.08),
    transparent
  );
  opacity:0;
  transition:.4s;
}

.code-tabs .tab:hover::after{
  opacity:1;
}

.code-tabs .tab.active{
  background:linear-gradient(
    135deg,
    rgba(122,108,85,0.25),
    rgba(122,108,85,0.05)
  );
  color:var(--text);
  border-color:var(--accent);
  box-shadow:0 0 0 1px rgba(122,108,85,0.35);
}

/* =======================
   Code Box
======================= */

.code-box{
  display:none;
  background:linear-gradient(
    180deg,
    rgba(15,17,21,0.9),
    rgba(10,12,16,0.95)
  );
  border:1px solid var(--border);
  border-radius:18px;
  padding:18px 20px;
  backdrop-filter:blur(12px);
  box-shadow:
    inset 0 0 0 1px rgba(255,255,255,0.02),
    0 15px 40px rgba(0,0,0,0.7);
  overflow-x:auto;
  animation:fadeUp .35s ease;
}

.code-box.active{
  display:block;
}

.code-box code{
  font-family: "JetBrains Mono", monospace;
  font-size:13px;
  line-height:1.8;
  color:#d7e0ea;
  white-space:pre;
}

/* Syntax vibes (soft – مش مبالغ) */
.code-box .keyword{ color:#c792ea }
.code-box .string{ color:#ecc48d }
.code-box .comment{ color:#6b7280; font-style:italic }
.code-box .function{ color:#82aaff }
.code-box .number{ color:#f78c6c }

/* =======================
   Small animation
======================= */

@keyframes fadeUp{
  from{
    opacity:0;
    transform:translateY(8px) scale(.98);
  }
  to{
    opacity:1;
    transform:translateY(0) scale(1);
  }
}
.menu-item,
.logout {
  text-decoration: none;
  color: inherit;
  display: flex;
  align-items: center;
}